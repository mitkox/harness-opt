#!/usr/bin/env python3
"""Offline development entry point. Never downloads or updates dependencies."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import venv
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def python():
    for name in (".venv", ".venv-m1"):
        candidate = (ROOT / name).resolve() / "bin/python"
        if candidate.exists():
            return str(candidate)
    raise ValueError("No environment. Run scripts/dev bootstrap with an approved wheelhouse.")


def run(command, **kwargs):
    return subprocess.run(
        command,
        cwd=ROOT,
        env={**os.environ, "PYTHONPATH": str(ROOT / "src")},
        check=False,
        **kwargs,
    ).returncode


class ToolUnavailable(ValueError):
    """An approved offline tool artifact is not available; never substitute one."""


SHA256 = re.compile(r"[0-9a-f]{64}")

# name, pin kind, arguments. The kind is the resolution contract: a wheel_artifact
# or local_environment is only ever executed from its approved artifact, never from PATH.
CHECK_COMMANDS = (
    ("ruff", "local_binary", ("check", "src", "tests", "scripts/dev")),
    ("ruff", "local_binary", ("format", "--check", "src", "tests", "scripts/dev")),
    ("mypy", "local_environment", ("--python-version", "3.14", "src/hop")),
)


def load_tools():
    path = ROOT / "development-tools.lock.json"
    if not path.is_file():
        raise ToolUnavailable(f"approved tool lock {path.name} is missing")
    lock = json.loads(path.read_text())
    if lock.get("schema_version") not in (1, 2):
        raise ToolUnavailable(f"unsupported tool lock schema {lock.get('schema_version')!r}")
    return lock.get("tools") or {}


def expand_pin_path(value):
    """Expand the documented ${HOME}/~ forms in a pinned path. Never guesses."""
    return os.path.expanduser(os.path.expandvars(value))


def lock_wheelhouse():
    path = ROOT / "development-tools.lock.json"
    try:
        value = json.loads(path.read_text()).get("wheelhouse")
    except (OSError, ValueError):
        return None
    if not isinstance(value, str) or not value:
        return None
    return expand_pin_path(value)


def approved_wheelhouse():
    wheelhouse = Path(
        os.environ.get("HOP_WHEELHOUSE", lock_wheelhouse() or str(ROOT / ".vendor/wheels"))
    ).resolve()
    if not wheelhouse.is_dir():
        raise ToolUnavailable(f"approved wheelhouse is missing: {wheelhouse}")
    return wheelhouse


def tools_environment():
    environment = Path(os.environ.get("HOP_TOOLS_VENV", str(ROOT / ".venvs" / "tools")))
    if not environment.is_absolute():
        environment = ROOT / environment
    return environment


def verified_artifact(wheelhouse, name, entry):
    filename = entry.get("wheel")
    digest = entry.get("sha256")
    if not filename or not isinstance(digest, str) or not SHA256.fullmatch(digest):
        raise ToolUnavailable(f"approved offline {name} is unpinned (wheel+sha256 required)")
    if Path(filename).name != filename:
        raise ToolUnavailable(f"approved offline {name} pin must name a wheel file, not a path")
    artifact = wheelhouse / filename
    if not artifact.is_file():
        raise ToolUnavailable(f"approved offline {name} wheel is not in the wheelhouse: {artifact}")
    if hashlib.sha256(artifact.read_bytes()).hexdigest() != digest:
        raise ToolUnavailable(f"{name} wheel integrity check failed: {artifact}")
    return artifact


def verify_manifest(manifest, name):
    """Verify every file named by an approved artifact manifest, failing closed."""
    for number, line in enumerate(manifest.read_text().splitlines(), 1):
        if not line.strip():
            continue
        digest, separator, path = line.partition("  ")
        target = Path(path)
        if separator != "  " or not SHA256.fullmatch(digest) or not target.is_absolute():
            raise ToolUnavailable(f"approved offline {name} manifest line {number} is malformed")
        if not target.is_file():
            raise ToolUnavailable(f"approved offline {name} manifest file is missing: {target}")
        if hashlib.sha256(target.read_bytes()).hexdigest() != digest:
            raise ToolUnavailable(f"{name} manifest integrity check failed: {target}")


def resolve_approved_tool(tools, name, kind):
    """Return the argv prefix for an approved tool, or fail closed. Never guesses."""
    pin = tools.get(name)
    if not isinstance(pin, dict):
        raise ToolUnavailable(
            f"approved offline {name} is not configured in development-tools.lock.json"
        )
    if pin.get("kind", "local_binary") != kind:
        raise ToolUnavailable(
            f"approved offline {name} pin kind {pin.get('kind')!r} does not match required {kind!r}"
        )
    if kind == "local_binary":
        if pin.get("status") != "pinned_local_binary" or not SHA256.fullmatch(
            pin.get("sha256") or ""
        ):
            raise ToolUnavailable(f"approved offline {name} is unpinned")
        executable = shutil.which(name)
        if not executable:
            raise ToolUnavailable(f"approved offline {name} executable is unavailable")
        if hashlib.sha256(Path(executable).read_bytes()).hexdigest() != pin["sha256"]:
            raise ToolUnavailable(f"{name} build does not match the approved local pin")
        return [executable]
    if kind == "wheel_artifact":
        if pin.get("status") != "pinned_wheel":
            raise ToolUnavailable(
                f"approved offline {name} is not pinned (status={pin.get('status', 'absent')}); "
                "no PATH substitute is accepted"
            )
        wheelhouse = approved_wheelhouse()
        for entry in (pin, *pin.get("requirements", [])):
            verified_artifact(wheelhouse, entry.get("name", name), entry)
        interpreter = tools_environment() / "bin/python"
        if not interpreter.is_file():
            raise ToolUnavailable(
                f"approved offline {name} environment is missing: {interpreter.parent.parent} "
                "(run scripts/dev bootstrap-tools)"
            )
        return [str(interpreter), "-m", pin.get("module") or name]
    if kind == "local_environment":
        if pin.get("status") != "pinned_local_environment":
            raise ToolUnavailable(
                f"approved offline {name} is not pinned (status={pin.get('status', 'absent')}); "
                "no PATH substitute is accepted"
            )
        override_var = f"HOP_{name.upper()}_PYTHON"
        configured_value = os.environ.get(override_var, "") or pin.get("interpreter")
        if not isinstance(configured_value, str) or not configured_value:
            raise ToolUnavailable(
                f"approved offline {name} needs a pinned interpreter; "
                f"set {override_var} to an approved copy"
            )
        # A pin may use the documented ${HOME}/~ forms so the repository carries
        # no hardcoded username.
        interpreter = expand_pin_path(configured_value)
        if not Path(interpreter).is_absolute():
            raise ToolUnavailable(
                f"approved offline {name} needs an absolute pinned interpreter; "
                f"set {override_var} to an approved copy"
            )
        # The configured path is what gets EXECUTED: for a venv it selects the
        # venv's site-packages. ``resolved`` (the symlink target) is used only
        # for the integrity hash, which is what the pin records.
        resolved = Path(interpreter).resolve()
        if not resolved.is_file():
            raise ToolUnavailable(
                f"approved offline {name} interpreter is missing: {interpreter}; "
                f"set {override_var} to an approved copy of "
                f"{pin.get('interpreter_version', 'the pinned version')} "
                "(it must match the pinned sha256)"
            )
        if hashlib.sha256(resolved.read_bytes()).hexdigest() != pin.get("interpreter_sha256"):
            raise ToolUnavailable(
                f"{name} interpreter does not match the approved pin; "
                f"{override_var} must point at the same approved build"
            )
        wheelhouse = approved_wheelhouse()
        manifest_name = pin.get("manifest")
        if not manifest_name or Path(manifest_name).name != manifest_name:
            raise ToolUnavailable(f"approved offline {name} needs a manifest file name")
        manifest = wheelhouse / manifest_name
        if not manifest.is_file():
            raise ToolUnavailable(f"approved offline {name} manifest is missing: {manifest}")
        if hashlib.sha256(manifest.read_bytes()).hexdigest() != pin.get("manifest_sha256"):
            raise ToolUnavailable(f"{name} manifest does not match the approved pin")
        verify_manifest(manifest, name)
        return [interpreter, "-m", pin.get("module") or name]
    raise ToolUnavailable(f"approved offline {name} uses an unknown pin kind {kind!r}")


def bootstrap(args):
    if (
        sys.version_info[:2] != (3, 14)
        or platform.system() != "Linux"
        or platform.machine() != "x86_64"
        or platform.python_implementation() != "CPython"
    ):
        raise ValueError(
            "Offline wheelhouse currently evidenced for CPython 3.14/Linux x86-64 only."
        )
    wheelhouse = Path(
        os.environ.get("HOP_WHEELHOUSE", lock_wheelhouse() or str(ROOT / ".vendor/wheels"))
    ).resolve()
    target = Path(os.environ.get("HOP_LOCK_VENV", str(ROOT / ".venv")))
    if not target.is_absolute():
        target = ROOT / target
    if target.parent.resolve() != ROOT or not target.name.startswith(".venv"):
        raise ValueError("Environment link must be a .venv-prefixed path in this workspace.")
    if target.exists() and not target.is_symlink():
        raise ValueError(
            f"Preserving existing directory {target}; choose a new HOP_LOCK_VENV link."
        )
    if target.is_symlink():
        previous = target.resolve()
        if previous.parent != ROOT / ".venvs" or not (previous / "pyvenv.cfg").exists():
            raise ValueError("Refusing to replace an environment link not managed by scripts/dev.")
    lock = ROOT / ("requirements-runtime.lock" if args.runtime else "requirements.lock")
    if not wheelhouse.is_dir():
        raise ValueError(f"Missing approved wheelhouse: {wheelhouse}. No packages downloaded.")
    blocks = re.split(r"(?m)(?=^[A-Za-z0-9_-]+==)", lock.read_text())
    wheels = list(wheelhouse.glob("*.whl"))
    for block in blocks:
        match = re.match(r"([A-Za-z0-9_-]+)==([^\s\\]+)", block)
        if not match:
            continue
        name, version = match.groups()
        prefix = name.lower().replace("-", "_") + "-" + version + "-"
        hashes = set(re.findall(r"--hash=sha256:([0-9a-f]{64})", block))
        candidates = [p for p in wheels if p.name.lower().startswith(prefix)]
        if not candidates or not hashes:
            raise ValueError(f"Missing pinned wheel or hash for {name}=={version}")
        if not any(hashlib.sha256(p.read_bytes()).hexdigest() in hashes for p in candidates):
            raise ValueError(f"Wheel integrity check failed for {name}=={version}")
    parent = ROOT / ".venvs"
    parent.mkdir(exist_ok=True)
    directory = Path(tempfile.mkdtemp(prefix="env-", dir=parent))
    published = False
    try:
        venv.EnvBuilder(with_pip=True, symlinks=True).create(directory)
        executable = str(directory / "bin/python")
        command = [
            executable,
            "-m",
            "pip",
            "install",
            "--disable-pip-version-check",
            "--no-cache-dir",
            "--no-index",
            "--find-links",
            str(wheelhouse),
            "--require-hashes",
            "-r",
            str(lock),
        ]
        if run(command):
            raise ValueError("Offline installation failed; previous environment preserved.")
        if run([executable, "-m", "hop.cli", "--help"], stdout=subprocess.DEVNULL):
            raise ValueError("New environment failed CLI validation.")
        if run([executable, "-c", "import pydantic, yaml, pytest"]):
            raise ValueError("New environment lacks required runtime/verifier dependencies.")
        if args.run_tests and run([executable, "-m", "pytest", "tests", "-m", "not live", "-q"]):
            raise ValueError("New environment failed tests; previous environment preserved.")
        link = ROOT / (target.name + ".pending")
        if link.exists() or link.is_symlink():
            raise ValueError(f"Pending environment switch exists: {link}")
        created_link = False
        try:
            link.symlink_to(directory)
            created_link = True
            os.replace(link, target)
        finally:
            if created_link and link.is_symlink():
                link.unlink()
        published = True
        print(json.dumps({"environment": str(target), "runtime_only": args.runtime}))
        return 0
    finally:
        if not published:
            shutil.rmtree(directory)


def bootstrap_tools(args):
    """Build the approved tool environment from pinned wheels only. Never installs unpinned."""
    tools = load_tools()
    pins = [
        (name, pin)
        for name, pin in sorted(tools.items())
        if isinstance(pin, dict) and pin.get("kind") == "wheel_artifact"
    ]
    all_pins = sorted(name for name, pin in tools.items() if isinstance(pin, dict))
    if not all_pins:
        raise ToolUnavailable("no approved offline tool artifacts are configured")
    if not pins:
        local = all_pins
        print(
            "no approved offline wheel-artifact tools to build; local pins resolve in place: "
            f"{', '.join(local) or 'none'}. Relocate the approved toolchain with "
            "HOP_WHEELHOUSE / HOP_MYPY_PYTHON (both hash-verified; a PATH tool is never "
            "accepted). See README.md."
        )
        return 0
    wheelhouse = approved_wheelhouse()
    lines = []
    for name, pin in pins:
        if pin.get("status") != "pinned_wheel":
            raise ToolUnavailable(
                f"approved offline {name} is not pinned (status={pin.get('status', 'absent')})"
            )
        for entry in (pin, *pin.get("requirements", [])):
            verified_artifact(wheelhouse, entry.get("name", name), entry)
            lines.append(
                f"{entry.get('name', name)}=={entry.get('version')} --hash=sha256:{entry['sha256']}"
            )
    target = tools_environment()
    if target.exists() or target.is_symlink():
        raise ToolUnavailable(
            f"Preserving existing tool environment {target}; remove it to rebuild."
        )
    parent = ROOT / ".venvs"
    parent.mkdir(exist_ok=True)
    directory = Path(tempfile.mkdtemp(prefix="tools-", dir=parent))
    published = False
    try:
        venv.EnvBuilder(with_pip=True, symlinks=True).create(directory)
        executable = str(directory / "bin/python")
        requirements = directory / "tools-requirements.lock"
        requirements.write_text("\n".join(lines) + "\n")
        command = [
            executable,
            "-m",
            "pip",
            "install",
            "--disable-pip-version-check",
            "--no-cache-dir",
            "--no-index",
            "--no-deps",
            "--find-links",
            str(wheelhouse),
            "--require-hashes",
            "-r",
            str(requirements),
        ]
        if run(command):
            raise ToolUnavailable("Offline tool installation failed; no environment published.")
        for name, pin in pins:
            module = pin.get("module") or name
            if run([executable, "-c", f"import {module}"]):
                raise ToolUnavailable(f"New tool environment cannot import approved {name}.")
        os.rename(directory, target)
        published = True
        print(json.dumps({"tool_environment": str(target), "tools": [name for name, _ in pins]}))
        return 0
    finally:
        if not published:
            shutil.rmtree(directory)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    build = sub.add_parser("bootstrap", help="Build and validate a new offline environment")
    build.add_argument("--runtime", action="store_true")
    build.add_argument("--run-tests", action="store_true")
    sub.add_parser(
        "bootstrap-tools",
        help="Build the pinned approved-artifact tool environment (offline, no PATH fallback)",
    )
    test = sub.add_parser("test", help="Run a selected test suite")
    test.add_argument(
        "--suite", choices=("unit", "contract", "sandbox", "all", "live"), default="unit"
    )
    sub.add_parser("check", help="Run static checks without changing source")
    sub.add_parser("acceptance", help="Run all available gates, failing on any blocked gate")
    args = parser.parse_args()
    try:
        if args.command == "bootstrap":
            if args.runtime and args.run_tests:
                raise ValueError("Runtime-only environments do not include test dependencies.")
            return bootstrap(args)
        if args.command == "bootstrap-tools":
            return bootstrap_tools(args)
        if args.command == "test":
            marker = "not live" if args.suite == "all" else args.suite
            return run([python(), "-m", "pytest", "tests", "-m", marker, "-o", "addopts=", "-q"])
        if args.command == "acceptance":
            status = run([sys.executable, str(Path(__file__)), "check"])
            tests = run([python(), "-m", "pytest", "tests", "-m", "not live", "-q"])
            print(
                "BLOCKED: live local-model acceptance and independent boundary review required.",
                file=sys.stderr,
            )
            return status or tests or 3
        tools = load_tools()
        statuses = []
        for name, kind, arguments in CHECK_COMMANDS:
            try:
                command = resolve_approved_tool(tools, name, kind)
            except ToolUnavailable as exc:
                print(f"BLOCKED: {exc}", file=sys.stderr)
                statuses.append(3)
                continue
            statuses.append(run([*command, *arguments]))
        return next((status for status in statuses if status), 0)
    except (OSError, ValueError) as exc:
        print(f"BLOCKED: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
