{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hop.local/specs/case-package.schema.json",
  "title": "HOP CasePackage",
  "description": "Record for a materialized case package. Frozen by AOP-020 half A (WP-2.1a). hidden_ref is an opaque token: packs must never resolve sealed paths from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "case_id",
    "group_id",
    "root",
    "task_path",
    "public_tests",
    "hidden_ref",
    "visible_tests",
    "provenance_path",
    "repository_manifest_path",
    "environment_lock_path",
    "content_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "kind": {"const": "CasePackage"},
    "case_id": {"type": "string", "pattern": "^case-[0-9a-f]{16}$"},
    "group_id": {"type": "string", "pattern": "^group-[0-9a-f]{16}$"},
    "root": {"type": "string", "minLength": 1, "description": "package directory name, relative to the import output root"},
    "task_path": {"type": "string", "minLength": 1},
    "public_tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "hidden_ref": {
      "type": "string",
      "pattern": "^(unassigned|sealed-unassigned:case-[0-9a-f]{16}|[0-9a-f]{32})$",
      "description": "OPAQUE holdout token in one of three legitimate forms. Packs must not resolve it; sealed tokens are attached in memory and never persisted in package files (AOP-020 half B)."
    },
    "visible_tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance_path": {"type": "string"},
    "repository_manifest_path": {"type": "string"},
    "environment_lock_path": {"type": "string"},
    "content_digest": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
