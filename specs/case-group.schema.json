{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hop.local/specs/case-group.schema.json",
  "title": "HOP CaseGroup",
  "description": "One data group of related local commits. Frozen by AOP-020 half A (WP-2.1a).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "group_id",
    "repository",
    "commit_shas",
    "patch_digests",
    "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "kind": {"const": "CaseGroup"},
    "group_id": {"type": "string", "pattern": "^group-[0-9a-f]{16}$"},
    "repository": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit_shas": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    },
    "patch_digests": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "created_at": {"type": "string"}
  }
}
