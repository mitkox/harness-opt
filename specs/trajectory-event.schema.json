{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOP trajectory event envelope v0.2 (M2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "run_id",
    "attempt_id",
    "agent_id",
    "source",
    "source_sequence",
    "observed_at",
    "bundle_digest",
    "trace_id",
    "span_id",
    "synthetic_fixture",
    "payload_refs",
    "attributes"
  ],
  "properties": {
    "schema_version": {
      "enum": ["0.1", "0.2"]
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "parent_agent_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "authority": {
          "description": "Who produced the bytes. Harness/model output is never automatically trusted. See docs/adr/ADR-004-event-authority.md.",
          "enum": [
            "platform_observation",
            "harness_observation",
            "agent_claim",
            "model_output",
            "verifier_fact",
            "synthetic_fixture"
          ]
        }
      }
    },
    "source_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_timestamp": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "parent_span_id": {
      "type": "string"
    },
    "model_deployment_digest": {
      "type": "string"
    },
    "harness_digest": {
      "type": "string"
    },
    "repo_snapshot_digest": {
      "type": "string"
    },
    "environment_digest": {
      "type": "string"
    },
    "profile_id": {
      "type": "string",
      "description": "M3 source profile identity (name@version); empty for M1/M2 events."
    },
    "profile_digest": {
      "type": "string",
      "description": "M3 source profile digest; lock_digest carries the frozen resolution."
    },
    "lock_digest": {
      "type": "string",
      "description": "M3 lockfile digest; empty for M1/M2 events."
    },
    "compiled_target": {
      "type": "string"
    },
    "compiled_target_digest": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "skill_version": {
      "type": "string"
    },
    "skill_digest": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "data_classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "secret"]
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "payload_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object"
    },
    "parent_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
