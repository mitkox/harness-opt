{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOP draft SkillSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "status",
    "description",
    "immutable_contract",
    "optimization_surfaces",
    "trigger_cases",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "SkillSpec"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "approved",
        "retired"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "immutable_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "required_evidence",
        "permission_ceiling",
        "forbidden_behaviors"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "permission_ceiling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "optimization_surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "description",
          "instructions",
          "examples",
          "scripts",
          "resources",
          "selection_policy"
        ]
      }
    },
    "trigger_cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "negative": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
